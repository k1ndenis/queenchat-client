{
  "appId": "ru.queenchat.app",
  "appName": "QueenChat",
  "webDir": "dist",
  "server": {
    "url": "https://queenchat.ru",
    "cleartext": false,
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#FFFFFF",
      "showSpinner": false,
      "androidScaleType": "CENTER_INSIDE"
    },
    "PushNotifications": {
      "presentationOptions": []
    }
  }
}
